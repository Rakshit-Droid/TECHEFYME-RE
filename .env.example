# Booking link used by every "Book a call" / "Book a discovery call" CTA (GHL calendar, Calendly, ...).
# Without it, CTAs scroll to the contact form.
NEXT_PUBLIC_BOOKING_URL=

# Enquiry delivery. Set at least one in production, or the form shows the email/phone fallback.
FORM_WEBHOOK_URL=
RESEND_API_KEY=
ENQUIRY_TO=hello@techefyme.com
ENQUIRY_FROM=TechefyMe <enquiries@techefyme.com>
